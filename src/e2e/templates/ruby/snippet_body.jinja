require "{{ require_path }}"
{% if expects_error %}begin
{% endif %}
{% for line in setup_lines %}
{% if expects_error %}  {% endif %}{{ line }}
{% endfor %}
{% if client_factory %}
{% if expects_error %}  {% endif %}client = {{ receiver }}.{{ client_factory }}("your-api-key")
{% endif %}
{% if returns_void %}
{% if expects_error %}  {% endif %}{{ call_receiver }}.{{ function }}({{ args }})
{% elif is_streaming %}
{% if expects_error %}  {% endif %}chunks = {{ call_receiver }}.{{ function }}({{ args }}).to_a
{% else %}
{% if expects_error %}  {% endif %}{{ result_var }} = {{ call_receiver }}.{{ function }}({{ args }})
{% endif %}
{% if expects_error %}rescue StandardError => error
  warn "Call failed as expected: #{error.message}"
else
  raise "expected call to fail"
end
{% endif %}
