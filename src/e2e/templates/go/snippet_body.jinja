package main import (
{% for import in standard_imports %}
  "{{ import }}"
{% endfor %}
{% if standard_imports %}
{% endif %}
{{ import_alias }} "{{ module }}" )

{% for declaration in package_decls %}
  {{ declaration }}
{% endfor %}
func main() {
{% for line in setup_lines %}
  {{ line }}
{% endfor %}
{% if client_setup %}
  {{ client_setup }}
{% endif %}
{% if returns_void %}
  err := {{ call_expr }}
{% elif returns_error %}
  {{ result_var }}, err := {{ call_expr }}
{% else %}
  {{ result_var }} := {{ call_expr }}
{% endif %}
{% if returns_error or returns_void %}
  if err != nil { panic(err) }
{% endif %}
{% if not returns_void %}
  fmt.Println({{ result_var }})
{% endif %}
}
