import { {{ imports | join(", ") }} } from "{{ module }}";
{% if is_async %}
async function main() {
{% for line in setup_lines %}
  {{ line }}
{% endfor %}
{% if client_setup %}
  {{ client_setup }}
{% endif %}
  const {{ result_var }} = await {{ call_expr }};
  return {{ result_var }};
}

void main();
{% else %}
{% for line in setup_lines %}
{{ line }}
{% endfor %}
{% if client_setup %}
{{ client_setup }}
{% endif %}
const {{ result_var }} = {{ call_expr }};
{% endif %}
