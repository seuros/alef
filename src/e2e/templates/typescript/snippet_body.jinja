import { {{ imports | join(", ") }} } from "{{ module }}";
{% if is_async %}
async function main() {
{% for line in setup_lines %}
  {{ line }}
{% endfor %}
{% if client_setup %}
  {{ client_setup }}
{% endif %}
{% if expects_error %}  try {
    await {{ call_expr }};
  } catch (error) {
    console.error("Call failed as expected:", error);
    return;
  }
  throw new Error("expected call to fail");
{% else %}
  const {{ result_var }} = await {{ call_expr }};
{% for operation in presentation %}
{% if operation.kind == "show" %}  console.log({{ operation.expression }});
{% else %}{% if operation.destructure_source %}  const [{{ operation.destructure_item }}] = {{ operation.destructure_source }};
{% endif %}  for (const {{ operation.item }} of {{ operation.expression }}{% if operation.optional %} ?? []{% endif %}) {
{% for field in operation.fields %}    console.log({{ field }});
{% endfor %}  }
{% endif %}
{% endfor %}
{% endif %}
}

void main();
{% else %}
function main() {
{% for line in setup_lines %}
  {{ line }}
{% endfor %}
{% if client_setup %}
  {{ client_setup }}
{% endif %}
{% if expects_error %}try {
    {{ call_expr }};
  } catch (error) {
    console.error("Call failed as expected:", error);
    return;
  }
  throw new Error("expected call to fail");
{% else %}
  const {{ result_var }} = {{ call_expr }};
{% for operation in presentation %}
{% if operation.kind == "show" %}  console.log({{ operation.expression }});
{% else %}{% if operation.destructure_source %}  const [{{ operation.destructure_item }}] = {{ operation.destructure_source }};
{% endif %}  for (const {{ operation.item }} of {{ operation.expression }}{% if operation.optional %} ?? []{% endif %}) {
{% for field in operation.fields %}    console.log({{ field }});
{% endfor %}  }
{% endif %}
{% endfor %}
{% endif %}
}

void main();
{% endif %}
