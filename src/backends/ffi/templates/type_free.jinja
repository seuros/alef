/// Free a `{{ type_name }}` handle.
/// # Safety
/// Handle must have been returned by this library, or be zero.
#[unsafe(no_mangle)]
pub unsafe extern "C" fn {{ prefix }}_{{ type_snake }}_free(handle: AlefHandle) {
    catch_ffi_panic((), || {
    if handle != 0
        && let Err(error) = remove_handle::<{% if serialized_handle %}SerializedHandle<{{ qualified }}>{% else %}{{ qualified }}{% endif %}>(handle)
    {
        set_handle_error(&error);
    }
    })
}
