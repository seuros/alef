            innerPtr,
            {% for meta_param in metadata_params %}{% if meta_param.is_opaque_wrapper %}{{ meta_param.name }}Ptr,
            {% else %}{{ meta_param.name }},
            {% endif %}{% endfor %}contextPtr,
