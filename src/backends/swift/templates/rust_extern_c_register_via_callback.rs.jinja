) -> i32 {
    // SAFETY: The caller guarantees a valid, live pointer to the service instance.
    let app = unsafe { &mut *app };
{%- for meta_param in metadata_params %}
{%- if meta_param.is_opaque_wrapper %}
    // SAFETY: the caller (Swift) passes the heap address of a live
    // {{ meta_param.rust_type }} instance obtained via `<Type>RawPtr`, held alive by a
    // strong reference on the Swift side for the duration of this call. We borrow
    // rather than take ownership so the swift-bridge-managed class is released
    // normally by Swift's ARC once the call returns.
    let {{ meta_param.name }} = unsafe { &*{{ meta_param.name }} };
