    app: *mut {{ service_name }},
{%- for meta_param in metadata_params %}
    {{ meta_param.name }}: {% if meta_param.is_opaque_wrapper %}*mut {{ meta_param.rust_type }}{% else %}{{ meta_param.rust_type }}{% endif %},
{%- endfor %}
    ctx: *mut std::ffi::c_void,
